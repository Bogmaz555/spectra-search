# Server-only — set in the Vercel project, never commit real values.
# The free search path works with every key below left empty.

# xAI Grok synthesis (optional). Without it, crawl and discovery still run.
XAI_API_KEY=

# Postgres (optional). Preview falls back to local PGLite when unset.
DATABASE_URL=

# Better Auth session (recommended in production).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Firecrawl scrape API (optional). POST https://api.firecrawl.dev/v1/scrape
# Without it the firecrawl adapter is skipped — local HTML is not labeled Firecrawl.
# https://www.firecrawl.dev/
FIRECRAWL_API_KEY=

# Brave Search API (optional discovery). Free tier exists; omitted = provider skipped.
# https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# Serper.dev Google results (optional, paid). Omitted = provider skipped.
# https://serper.dev/
SERPER_API_KEY=

# Browser Use Fetch (optional). Used only when a page is blocked or nearly empty.
# POST https://fetch.browser-use.com/fetch — no key means the adapter is skipped.
# https://browser-use.com/
BROWSER_USE_API_KEY=
# FETCH_USE_URL=

# Crawl4AI (optional). Either a cloud key or your own server.
# Cloud: POST https://api.crawl4ai.com/scrape
# Self-host: POST $CRAWL4AI_BASE_URL/md  (Bearer CRAWL4AI_API_TOKEN when the server requires it)
# Without both, markdown is a local HTML converter marked as an approximation.
CRAWL4AI_API_KEY=
CRAWL4AI_BASE_URL=
CRAWL4AI_API_TOKEN=
